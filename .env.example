LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 目標群組ID (可留空，留空則對所有有訊息的群組做摘要)
TARGET_GROUP_ID=

# 資料保留天數
MESSAGE_RETENTION_DAYS=7

# 時區 (用於每日日期切分)
TIMEZONE=Asia/Taipei

# 伺服器埠號 (Cloud Run 會自動注入 PORT，本機開發可自訂)
PORT=8080

# GCP 專案 ID (Firestore 所在專案)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# 本機開發用：service account 金鑰路徑
# 部署到 Cloud Run 時不需要設定，會自動使用內建服務帳戶
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Cloud Scheduler 呼叫 /api/run-summary 時的驗證密鑰，請改成隨機字串
CRON_SECRET=change_me_to_a_random_secret

# 每日摘要執行時，若有群組處理失敗，會用 LINE Push 通知這裡設定的對象
# (可留空；ADMIN_USER_ID 為個人帳號的 User ID，ADMIN_GROUP_ID 為群組 Group ID，可同時設定)
ADMIN_USER_ID=
ADMIN_GROUP_ID=

# --- 以下供 scripts/*.sh 部署腳本使用 ---

# Cloud Run / Firestore / Cloud Scheduler 所在區域
REGION=asia-east1

# Cloud Run 服務名稱
SERVICE_NAME=line-ai-summary

# 每日摘要 cron 排程 (分 時 日 月 週)，預設每晚 8 點
SUMMARY_SCHEDULE=0 20 * * *

# 僅供 scripts/05-setup-cicd.sh 使用：GitHub repo（owner/repo），
# 用於將 Workload Identity Federation 的信任範圍限制在這個 repo
GITHUB_REPO=papap35/line-ai-summary

